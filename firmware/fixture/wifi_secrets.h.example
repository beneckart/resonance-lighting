#pragma once

// Copy to wifi_secrets.h. That local file is gitignored and must never be
// committed. The first pair remains compatible with single-network builds.
#define RES_WIFI_SSID "<primary 2.4 GHz SSID>"
#define RES_WIFI_PASSWORD "<primary password>"

// Optional maintenance/OTA fallback. If both APs are visible, firmware tries
// the configured network with the stronger scan RSSI first.
#define RES_WIFI_SSID_2 "<secondary 2.4 GHz SSID>"
#define RES_WIFI_PASSWORD_2 "<secondary password>"
